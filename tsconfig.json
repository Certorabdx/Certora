{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@certora/core": ["packages/core/src/index.ts"],
      "@certora/beldex-adapter": ["packages/beldex-adapter/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "packages/core/src", "packages/beldex-adapter/src"]
}
